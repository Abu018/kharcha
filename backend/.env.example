PORT=8081
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=app
DB_PASSWORD=
DB_NAME=app
DB_SSLMODE=disable

KEYCLOAK_URL=http://localhost:8082
# Host port docker compose publishes Keycloak on; must match KEYCLOAK_URL
KEYCLOAK_PORT=8082
KEYCLOAK_REALM=expense-tracker
KEYCLOAK_CLIENT_ID=expense-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# OpenAI-compatible endpoint for the category model, e.g. Ollama
CLASSIFIER_URL=http://127.0.0.1:11434/v1/chat/completions
CLASSIFIER_MODEL=gemma3:4b

# Extra browser origins for the web app; localhost is always allowed
CORS_ALLOWED_ORIGINS=
