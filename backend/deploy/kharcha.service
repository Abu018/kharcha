# Copy to /etc/systemd/system/kharcha.service on the server, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now kharcha
# The API reads .env from WorkingDirectory.
[Unit]
Description=Kharcha API
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/kharcha/backend
ExecStart=/home/ubuntu/kharcha/backend/kharcha-api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
